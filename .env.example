# Nothing here is required. The default pipeline is deterministic, offline, standard-library Python.

# Answer writer: "deterministic" (default, extractive, no API calls) or "openai"
# ("openai" works with any OpenAI-compatible endpoint; retrieval is identical either way).
CANDOR_LLM_PROVIDER=deterministic

# Only used when CANDOR_LLM_PROVIDER=openai
# OPENAI_API_KEY=your_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# CANDOR_LLM_MODEL=gpt-4o-mini

# Example: Google AI Studio free tier through its OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# CANDOR_LLM_MODEL=gemini-2.5-flash
