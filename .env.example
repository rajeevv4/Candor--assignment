# Candor Workplace Memory & Action System Configuration

# LLM Provider: deterministic (default, zero API keys needed), openai, anthropic, or gemini
CANDOR_LLM_PROVIDER=deterministic

# Optional API Keys (Only if using LLM generation / judge)
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# ANTHROPIC_API_KEY=your_anthropic_key_here

# For Google Gemini free tier via OpenAI compatibility:
# OPENAI_API_KEY=your_google_ai_studio_key_here
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# CANDOR_LLM_MODEL=gemini-2.5-flash
